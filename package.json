{
  "name": "sisgedi",
  "version": "2.0.0",
  "description": "Sistema de Gestión de Documentación Integral - SISGEDI 2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx scripts/seed.ts",
    "seed:full": "tsx scripts/seed.ts --full",
    "seed:inventory": "tsx scripts/generate-inventory.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:init": "psql -U postgres -f database_schema.sql",
    "db:reset": "tsx scripts/reset-database.ts"
  },
  "keywords": [
    "SISGEDI",
    "gestión documental",
    "gobierno",
    "postgresql"
  ],
  "author": "SISGEDI Team",
  "license": "MIT",
  "dependencies": {
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "@supabase/ssr": "^0.0.10",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "lucide-react": "^0.294.0",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/pg": "^8.10.9",
    "@faker-js/faker": "^8.3.1",
    "@vitest/ui": "^1.0.4",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4"
  }
}
