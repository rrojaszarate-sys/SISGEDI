# ============================================================================
# SISGEDI 2.0 - CONFIGURACIÓN DE ENTORNO
# ============================================================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo como .env.local
# 2. Reemplazar todos los valores de ejemplo con tus credenciales reales
# 3. NUNCA subir archivos .env a Git (ya está en .gitignore)
#
# ============================================================================

# ============================================================================
# SUPABASE - CONFIGURACIÓN PRINCIPAL
# ============================================================================
# Obtén estos valores desde: https://app.supabase.com/project/_/settings/api

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave Anónima (pública) - Segura para usar en frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR1LXByb3llY3RvIiwicm9sZSI6ImFub24iLCJpYXQiOjE2ODAwMDAwMDAsImV4cCI6MTk5NTU3NjAwMH0.EJEMPLO

# Clave de Servicio (privada) - Solo para backend/servidor
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR1LXByb3llY3RvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTY4MDAwMDAwMCwiZXhwIjoxOTk1NTc2MDAwfQ.EJEMPLO

# ============================================================================
# SUPABASE STORAGE - CONFIGURACIÓN DE BUCKETS
# ============================================================================

# Buckets disponibles (ya creados en Supabase)
STORAGE_BUCKET_DOCUMENTOS=documentos
STORAGE_BUCKET_DOCUMENTOS_SALIENTES=documentos-salientes
STORAGE_BUCKET_ACUSES=acuses
STORAGE_BUCKET_INVENTARIO=inventario
STORAGE_BUCKET_FIRMAS=firmas

# Límites de tamaño de archivos (en bytes)
MAX_FILE_SIZE_DOCUMENTOS=52428800           # 50 MB
MAX_FILE_SIZE_DOCUMENTOS_SALIENTES=10485760 # 10 MB
MAX_FILE_SIZE_ACUSES=5242880                # 5 MB
MAX_FILE_SIZE_INVENTARIO=10485760           # 10 MB
MAX_FILE_SIZE_FIRMAS=1048576                # 1 MB

# MIME types permitidos
ALLOWED_MIME_DOCUMENTOS=application/pdf,image/*,application/msword,application/vnd.openxmlformats-officedocument.*
ALLOWED_MIME_DOCUMENTOS_SALIENTES=application/pdf
ALLOWED_MIME_ACUSES=application/pdf,image/*
ALLOWED_MIME_INVENTARIO=image/*
ALLOWED_MIME_FIRMAS=application/x-pkcs12,application/x-x509-ca-cert

# ============================================================================
# GOOGLE CLOUD VISION API - OCR
# ============================================================================

# Proyecto de Google Cloud
GOOGLE_CLOUD_PROJECT_ID=gen-lang-client-0562056452

# Credenciales de Service Account (JSON)
# Path al archivo JSON (recomendado - el archivo está en .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# NOTA IMPORTANTE:
# El archivo google-credentials.json ya fue creado localmente con tus credenciales.
# Este archivo NO se sube a Git por seguridad (está en .gitignore).
# Para deployment en servicios cloud, usa secrets/environment variables de la plataforma.

# Configuración de OCR
OCR_LANGUAGE_HINTS=es,en
OCR_MIN_CONFIDENCE=0.7
OCR_ENABLE_TEXT_DETECTION=true
OCR_ENABLE_DOCUMENT_TEXT_DETECTION=true

# ============================================================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================================================

# Tiempo de expiración de sesión (en segundos)
SESSION_TIMEOUT=3600                # 1 hora
SESSION_REFRESH_THRESHOLD=300       # Refrescar 5 minutos antes

# JWT Secret (para tokens adicionales, NO para Supabase Auth)
JWT_SECRET=tu-secret-muy-seguro-aqui-cambiar-en-produccion

# Configuración de cookies
COOKIE_SECURE=true                  # true en producción (HTTPS)
COOKIE_SAME_SITE=lax               # lax o strict

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100        # Máximo de requests por ventana
RATE_LIMIT_WINDOW_MS=900000        # Ventana de 15 minutos

# ============================================================================
# APLICACIÓN - CONFIGURACIÓN GENERAL
# ============================================================================

# Entorno de ejecución
NODE_ENV=development                # development | production | test

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Puerto del servidor (desarrollo)
PORT=3000

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=SISGEDI 2.0
NEXT_PUBLIC_APP_VERSION=2.0.0

# Configuración regional
NEXT_PUBLIC_LOCALE=es-MX
NEXT_PUBLIC_TIMEZONE=America/Mexico_City

# ============================================================================
# FEATURES FLAGS - HABILITAR/DESHABILITAR FUNCIONALIDADES
# ============================================================================

FEATURE_OCR_ENABLED=true
FEATURE_DIGITAL_SIGNATURE=true
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=false
FEATURE_EXPORT_EXCEL=true
FEATURE_EXPORT_PDF=true

# ============================================================================
# EMAIL / NOTIFICACIONES (OPCIONAL)
# ============================================================================

# SMTP Configuration (si usas servidor SMTP propio)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@dominio.gob.mx
SMTP_PASSWORD=tu-password-smtp

# Remitente por defecto
EMAIL_FROM=noreply@sisgedi.gob.mx
EMAIL_FROM_NAME=SISGEDI 2.0

# ============================================================================
# DESARROLLO - SEED DATA
# ============================================================================

# Cantidad de datos de prueba a generar
SEED_UNIDADES_ADMINISTRATIVAS=20
SEED_USUARIOS_PER_UA=5
SEED_DOCUMENTOS_ENTRANTES=100
SEED_DOCUMENTOS_SALIENTES=50
SEED_TURNADOS_PER_DOC=3
SEED_INVENTARIO_ITEMS=50

# Modo de generación
SEED_MODE=standard                  # standard | full | minimal

# ============================================================================
# TESTING
# ============================================================================

# Base de datos de pruebas (Supabase permite crear proyectos separados)
TEST_SUPABASE_URL=https://tu-proyecto-test.supabase.co
TEST_SUPABASE_ANON_KEY=tu-clave-anon-test

# ============================================================================
# LOGGING Y MONITOREO (OPCIONAL)
# ============================================================================

# Nivel de logs
LOG_LEVEL=info                      # debug | info | warn | error

# Habilitar logs de SQL (solo desarrollo)
LOG_SQL_QUERIES=false

# Servicio de monitoreo (Sentry, LogRocket, etc.)
SENTRY_DSN=
LOGROCKET_APP_ID=

# ============================================================================
# ANALYTICS (OPCIONAL)
# ============================================================================

GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# ============================================================================
# CONFIGURACIÓN AVANZADA
# ============================================================================

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10

# Timeout de queries (milisegundos)
DB_QUERY_TIMEOUT=30000

# Reintentos automáticos
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Cache (Redis, si lo usas)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300                       # 5 minutos

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# SEGURIDAD:
# - NUNCA compartas SUPABASE_SERVICE_ROLE_KEY públicamente
# - NUNCA subas archivos .env a repositorios Git
# - Usa diferentes valores para desarrollo y producción
# - Rota las credenciales periódicamente
#
# GOOGLE CLOUD CREDENTIALS:
# - El archivo google-credentials.json debe estar en la raíz del proyecto
# - O usa la variable GOOGLE_CLOUD_CREDENTIALS_JSON con el JSON completo
# - Asegúrate de que la cuenta de servicio tenga permisos de Cloud Vision API
#
# SUPABASE:
# - Ejecuta supabase_final.sql en el SQL Editor de Supabase
# - Crea los 5 Storage Buckets manualmente
# - Crea el primer usuario admin desde Authentication
#
# ============================================================================
