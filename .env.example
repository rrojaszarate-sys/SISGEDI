# ==============================================
# SISGEDI 2.0 - Environment Variables Template
# ==============================================
# Copy this file to .env.local and fill in your values

# ==============================================
# SUPABASE
# ==============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================
# DATABASE
# ==============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/database

# Connection pooler URL (for serverless/Prisma)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Direct connection URL (for migrations)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ==============================================
# GOOGLE CLOUD (AI/ML Services)
# ==============================================
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts

GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Document AI
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
GOOGLE_DOCUMENT_AI_LOCATION=us

# ==============================================
# OPENAI (NLP, RAG, Generative AI)
# ==============================================
# Get API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# ==============================================
# EMAIL (Resend)
# ==============================================
# Get API key from: https://resend.com/api-keys

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SISGEDI <noreply@yourdomain.com>

# ==============================================
# REDIS (Upstash - Caching)
# ==============================================
# Get these from: https://console.upstash.com/

UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ==============================================
# MONITORING & LOGGING
# ==============================================

# Sentry (Error tracking)
# Get DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456
SENTRY_ORG=your-org
SENTRY_PROJECT=sisgedi-v2
SENTRY_AUTH_TOKEN=sntrys_...

# Axiom (Logging)
# Get token from: https://app.axiom.co/settings/tokens
AXIOM_TOKEN=xaat-...
AXIOM_ORG_ID=your-org-id
AXIOM_DATASET=sisgedi-logs

# ==============================================
# BLOCKCHAIN (Ethereum/Polygon)
# ==============================================

# Alchemy RPC
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/xxxxx
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/xxxxx

# Smart Contract Deployment Wallet
ETHEREUM_PRIVATE_KEY=0x...

# Contract Addresses (after deployment)
NOTARY_CONTRACT_ADDRESS=0x...

# ==============================================
# ENCRYPTION
# ==============================================
# Generate with: openssl rand -hex 32

ENCRYPTION_KEY=64_character_hex_string_here

# ==============================================
# FEATURE FLAGS
# ==============================================

NEXT_PUBLIC_ENABLE_BLOCKCHAIN=false
NEXT_PUBLIC_ENABLE_POST_QUANTUM=false
NEXT_PUBLIC_ENABLE_GREEN_IT=false
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# ==============================================
# DEPLOYMENT
# ==============================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel (auto-populated in production)
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=sisgedi-v2.vercel.app
